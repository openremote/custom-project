{
  "name": "@openremote/custom",
  "version": "1.0.0",
  "description": "OpenRemote Custom App",
  "author": "OpenRemote",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "exports": {
    "./*": "./lib/*.js"
  },
  "scripts": {
    "clean": "npx tsc -b --clean && npx shx rm -rf dist",
    "modelBuild": "npx orutil build",
    "modelWatch": "npx orutil watch",
    "build": "npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack --mode production",
    "serve": "npx tsc -b --clean && npx shx rm -rf dist && npx orutil build && npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack serve --mode development",
    "serveNoModelBuild": "npx tsc -b --clean && npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack serve --mode development",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@openremote/manager": "~1.28.1",
    "@openremote/or-app": "~1.28.1",
    "lit": "^3.3.1",
    "model": "workspace:*",
    "rest": "workspace:*"
  },
  "devDependencies": {
    "@openremote/util": "~1.28.1",
    "@rspack/cli": "^1.7.10",
    "@rspack/core": "^1.7.10",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "cross-env": "*",
    "css-loader": "*",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-wc": "3.1.0",
    "prettier": "3.9.6",
    "shx": "*",
    "ts-loader": "*",
    "typescript": "^5.9.3"
  }
}
